# Supabase - REDE INTERNA (backend -> supabase sem sair pra internet)
# Dentro do EasyPanel os dois serviços estão na mesma rede Docker
SUPABASE_INTERNAL_URL=http://agendaflow-supabase-kong:8000

# Fallback público (usado se INTERNAL não estiver setado) - igual ao frontend
VITE_SUPABASE_URL=https://agendaflow-supabase.fpczjb.easypanel.host

# Service role key (mesmo JWT_SECRET do ANON_KEY)
# NUNCA exponha no frontend. Só no servidor / EasyPanel Env.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Porta que o servidor escuta (EasyPanel injeta PORT automaticamente)
PORT=3001

# Opcional - validação de CPF externa
CPF_API_KEY=
