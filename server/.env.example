# Supabase connection (mesmo do frontend, expose publico)
VITE_SUPABASE_URL=https://agendaflow-supabasegestaodesaloes.fpczjb.easypanel.host

# Service role key (obtenha em Supabase Studio > Settings > API > service_role)
# NUNCA exponha no frontend. Só no servidor / EasyPanel Env.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Porta que o servidor escuta (EasyPanel injeta PORT automaticamente)
PORT=3001

# Opcional - validação de CPF externa
CPF_API_KEY=
