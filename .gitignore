# Env - nunca commitar segredos
.env
.env.*
!.env.example
!.env.local.example
# .env.local contem VITE_SUPABASE_ANON_KEY (pode ser commitado se anon)
# mas server/.env contem service_role - NUNCA commitar
server/.env
# backup/ mantido localmente apenas, nunca versionado (1 arquivo de cada na raiz)
backup/

# Sensitive / local
.env.stitch
.env.vscode/

# Build
dist
dist-ssr
*.local
!.env.local

# Deps
node_modules
# package-lock DEVE ser commitado (necessário pro npm ci no Docker/EasyPanel)

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
server.out.log
server.err.log

# Tests & generated
test-results/
playwright-report/
stitch-output/
scripts/
coverage/

# Editor - manter configs essenciais do VSCode versionadas
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# EasyPanel - arquivos de cola (contêm chaves deste projeto, não commitar se forem secrets novos)
EASYPANEL-*.env
PASTE-*.env

# Supabase local
supabase/.branches
supabase/.temp
