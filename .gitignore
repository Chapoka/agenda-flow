# Env - nunca commitar segredos (todas as chaves ficam só no disco/EasyPanel)
.env
.env.*
!.env.example
!.env.local.example
# server/.env contem SERVICE_ROLE_KEY - NUNCA commitar
server/.env
# backup/ mantido localmente apenas, nunca versionado (1 arquivo de cada na raiz)
backup/

# Sensitive / local
.env.stitch
.env.vscode/

# Build
dist
dist-ssr
*.local

# Deps
node_modules
# package-lock DEVE ser commitado (necessário pro npm ci no Docker/EasyPanel)

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
server.out.log
server.err.log

# Tests & generated
test-results/
playwright-report/
stitch-output/
scripts/
coverage/

# Editor - manter configs essenciais do VSCode versionadas
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# EasyPanel - arquivos de cola (contêm chaves deste projeto, não commitar se forem secrets novos)
EASYPANEL-*.env
PASTE-*.env
*.easypanel.ready
.supabase-easypanel*

# Supabase local e secrets self-hosted (contêm JWT_SECRET, SERVICE_ROLE_KEY, POSTGRES_PASSWORD)
supabase/.branches
supabase/.temp
supabase/.env
supabase/.env.*
supabase/*.env
supabase/.env.easypanel.ready
supabase/.env.easypanel.ready.example
